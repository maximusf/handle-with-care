[node name="TutorialSigns" type="Node2D" parent="." unique_id=1473158606]

[node name="WelcomeSign" parent="TutorialSigns" unique_id=339081663 instance=ExtResource("sign_scene")]
position = Vector2(-1330, 0)
text = "Welcome, new \"Yeet\" employee!
Your job as our new hire is to deliver packages in the most laziest way possible.
Yes, you must kick the packages! Be careful: if you break one, it's coming out of your paycheck. (You're unpaid.)"

[node name="ControlsSign" parent="TutorialSigns" unique_id=153710184 instance=ExtResource("sign_scene")]
position = Vector2(-1150, 0)
text = "CONTROLS
Hold A to move left, hold D to move right.
Press SPACE to jump."

[node name="KickSign" parent="TutorialSigns" unique_id=1692467581 instance=ExtResource("sign_scene")]
position = Vector2(-950, 0)
text = "Hold LMB to charge your kick, release LMB to kick.
While holding LMB, click RMB to cancel the kick."

[node name="FreeCamSign" parent="TutorialSigns" unique_id=690620971 instance=ExtResource("sign_scene")]
position = Vector2(-750, 0)
text = "Press T to enter or exit free cam. In free cam, zoom in and out with the mouse wheel.
Press R to restart the level."

[node name="FindZoneSign" parent="TutorialSigns" unique_id=625901256 instance=ExtResource("sign_scene")]
position = Vector2(420, 0)
text = "Press T to enter free cam and look for the delivery zone."

[node name="StairsSign" parent="TutorialSigns" unique_id=579341423 instance=ExtResource("kickable_sign_scene")]
position = Vector2(2000, -16)
text = "Kick that package up the stairs.
The next delivery zone might need it!"

[node name="NpcSpeech" type="Node2D" parent="." unique_id=399655412]

[node name="ConciergeSpeech" parent="NpcSpeech" unique_id=1681559892 instance=ExtResource("speech_scene")]
position = Vector2(232, -84)
text = "It's another yeet employee... hurry up and kick the things."
speaker = "Concierge"

[node name="KindGuestSpeech" parent="NpcSpeech" unique_id=320106707 instance=ExtResource("speech_scene")]
position = Vector2(1048, -68)
text = "After 5 kicks, a package will break! So be careful."
speaker = "Benny"

[node name="DinosuitSpeech" parent="NpcSpeech" unique_id=1553201078 instance=ExtResource("speech_scene")]
position = Vector2(1720, -68)
text = "PSST... this is the delivery zone. If there's a checkmark, it's a successful delivery!"
speaker = "Timmy"

[node name="Concierge2Speech" parent="NpcSpeech" unique_id=1690571865 instance=ExtResource("speech_scene")]
position = Vector2(2472, -372)
text = "Please be gentle, I don't want to clean up your mess."
speaker = "Concierge"

[node name="RichLadySpeech" parent="NpcSpeech" unique_id=2015941032 instance=ExtResource("speech_scene")]
position = Vector2(2808, -356)
text = "Don't break my package again."
speaker = "Beatrice"
